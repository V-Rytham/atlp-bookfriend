PORT=5050
MONGODB_URI=mongodb://localhost:27017/after_the_last_page
# Optional alias used by some hosts:
# MONGO_URI=mongodb://localhost:27017/after_the_last_page

# LLM provider: mock | groq
BOOKFRIEND_LLM_PROVIDER=mock

# Groq (when BOOKFRIEND_LLM_PROVIDER=groq)
BOOKFRIEND_GROQ_MODEL=llama-3.3-70b-versatile
BOOKFRIEND_GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=your_api_key_here

# RAG tuning
BOOKFRIEND_MAX_HISTORY=12
BOOKFRIEND_RETRIEVAL_TOPK=5
BOOKFRIEND_MAX_CHUNK_CHARS=1200
BOOKFRIEND_MAX_MESSAGES_PER_SESSION=40
BOOKFRIEND_SESSION_TTL_MS=7200000

# Embeddings (BAAI/bge-small-en-v1.5 via Transformers.js)
BOOKFRIEND_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# MongoDB Atlas Vector Search
BOOKFRIEND_ATLAS_VECTOR_INDEX=book_chunks_embedding
